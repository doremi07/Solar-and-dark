<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles all of Assets/ against Unity reference assemblies (UNITY_LIB dir with UnityEngine.dll + UnityEditor.dll). -->
  <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><LangVersion>9.0</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/**/*.cs;TestRunnerStub.cs" />
    <Reference Include="UnityEngine"><HintPath>$(UNITY_LIB)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEditor"><HintPath>$(UNITY_LIB)/UnityEditor.dll</HintPath></Reference>
    <PackageReference Include="NUnit" Version="3.13.3" />
  </ItemGroup>
</Project>
